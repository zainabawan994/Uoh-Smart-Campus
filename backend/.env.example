# Copy to .env and edit values
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uoh_campus

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

UOH_BASE_URL=https://www.uoh.edu.pk
SCRAPE_INTERVAL_HOURS=6

UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Set to true to log SQL statements
DB_ECHO=false

# Public pages scanned for events, comma-separated (Facebook / Instagram / LinkedIn / society websites)
# e.g. https://www.facebook.com/UniversityOfHaripur,https://www.linkedin.com/school/university-of-haripur/
EVENT_SOURCES=

# Claude API key used to read uploaded cafe menu photos
ANTHROPIC_API_KEY=

# --- Security ---
# development | production. Production refuses to start while staff accounts use the public seed passwords.
ENVIRONMENT=development
# Session cookie: set COOKIE_SECURE=true once the site runs on HTTPS.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional: passwords used by seed.py instead of the public defaults
# SEED_ADMIN_PASSWORD=
# SEED_SECURITY_PASSWORD=
# SEED_CAFE_MANAGER_PASSWORD=
# SEED_STUDENT_PASSWORD=

# First admin for an empty production database (created once, only if no admin exists)
# ADMIN_PASSWORD=
# ADMIN_REG_NO=A00-0001
# ADMIN_EMAIL=admin@uoh.edu.pk
